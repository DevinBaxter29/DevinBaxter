#Blinky
from adafruit_circuitplayground import cp
import time

while True:
    for i in range(0,10):
        cp.pixels[i] = (0, 5, 0)
    time.sleep(0.367)

    for i in range(0, 10):
        cp.pixels[i] = (0, 0, 0)
    time.sleep(0.367)

#Woosh
from adafruit_circuitplayground import cp
import time

while True:
    if cp.button_a:
        for i in range(10):
            cp.pixels[i] = (0, 0, 5)
            time.sleep(0.1)
            cp.pixels[i] = (0, 0, 0)
            time.sleep(0.1)

#Flip Flop
from adafruit_circuitplayground import cp

while True:
    if cp.switch == True:
        for i in range(0, 5):
            cp.pixels[i] = (0, 5, 0)
        for i in range(5, 10):
            cp.pixels[i] = (0, 0, 0)
    else:
        for i in range(0, 5):
            cp.pixels[i] = (0, 0, 0)
        for i in range(5, 10):
            cp.pixels[i] = (0, 5, 0)

#Tippy
from adafruit_circuitplayground import cp

while True:
    x, y, z = cp.acceleration
    if x > 2:
        for i in range(1, 4):
            cp.pixels[i] = (0, 5, 0)
        for i in range(6, 9):
            cp.pixels[i] = (0, 0, 0)
    elif x < -2:
        for i in range(1, 4):
            cp.pixels[i] = (0, 0, 0)
        for i in range(6, 9):
            cp.pixels[i] = (5, 0, 0)
