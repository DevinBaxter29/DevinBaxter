#Counter
from adafruit_circuitplayground import cp
import time

cp.pixels.fill((0, 0, 0))
count = 0

while True:
    if cp.button_a:
        if count < 10:  
            cp.pixels[count] = (0, 0, 5)
            count += 1
        time.sleep(0.2) 
    if cp.button_b:
        if count > 0:
            count-= 1
            cp.pixels[count] = (0, 0, 0)
        time.sleep(0.2)    

#Light Meter
import time
from adafruit_circuitplayground import cp

while True:
    light = cp.light
    cp.pixels.fill((0, 0, 0))

    if light <= 3:
        cp.pixels[0:10] = [(5, 5, 5)] * 10
    elif light <= 6:
        cp.pixels[0:9] = [(5, 5, 5)] * 9
    elif light <= 9:
        cp.pixels[0:8] = [(5, 5, 5)] * 8
    elif light <= 12:
        cp.pixels[0:7] = [(5, 5, 5)] * 7
    elif light <= 15:
        cp.pixels[0:6] = [(5, 5, 5)] * 6
    elif light <= 18:
        cp.pixels[0:5] = [(5, 5, 5)] * 5
    elif light <= 21:
        cp.pixels[0:4] = [(5, 5, 5)] * 4
    elif light <= 24:
        cp.pixels[0:3] = [(5, 5, 5)] * 3
    elif light <= 27:
        cp.pixels[0:2] = [(5, 5, 5)] * 2
    elif light <= 30:
        cp.pixels = (5, 5, 5)

    time.sleep(1.0)

#Color Cycle
from adafruit_circuitplayground import cp
import time
count = 0

while True:

    if cp.button_a:
        count += 1
        time.sleep(0.25)
    elif count == 1:
        cp.pixels.fill((5,0,0))
    elif count == 2:
        cp.pixels.fill((5,2,0))
    elif count == 3:
        cp.pixels.fill((5,5,0))
    elif count == 4:
        cp.pixels.fill((0,5,0))
    elif count == 5:
        cp.pixels.fill((0,0,5))
    elif count == 6:
        cp.pixels.fill((1,0,6))
    elif count == 7:
        cp.pixels.fill((5,0,5))
    elif count > 7:
        count -= 7
        cp.pixels.fill((5,0,0))
