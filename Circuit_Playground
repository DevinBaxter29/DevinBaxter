#Blinky
from adafruit_circuitplayground import cp
import time

while True:
    for i in range(0,10):
        cp.pixels[i] = (0, 5, 0)
    time.sleep(0.367)

    for i in range(0, 10):
        cp.pixels[i] = (0, 0, 0)
    time.sleep(0.367)

#Woosh
from adafruit_circuitplayground import cp
import time

while True:
    if cp.button_a:
        for i in range(10):
            cp.pixels[i] = (0, 0, 5)
            time.sleep(0.1)
            cp.pixels[i] = (0, 0, 0)
            time.sleep(0.1)

#Flip Flop
from adafruit_circuitplayground import cp

while True:
    if cp.switch == True:
        for i in range(0, 5):
            cp.pixels[i] = (0, 5, 0)
        for i in range(5, 10):
            cp.pixels[i] = (0, 0, 0)
    else:
        for i in range(0, 5):
            cp.pixels[i] = (0, 0, 0)
        for i in range(5, 10):
            cp.pixels[i] = (0, 5, 0)

#Tippy
from adafruit_circuitplayground import cp

while True:
    x, y, z = cp.acceleration
    if x > 2:
        for i in range(1, 4):
            cp.pixels[i] = (0, 5, 0)
        for i in range(6, 9):
            cp.pixels[i] = (0, 0, 0)
    elif x < -2:
        for i in range(1, 4):
            cp.pixels[i] = (0, 0, 0)
        for i in range(6, 9):
            cp.pixels[i] = (5, 0, 0)

#Thermometer
from adafruit_circuitplayground import cp

while True:
    temp_f = cp.temperature * 1.8 + 32

    if temp_f < 78:
        cp.pixels[0] = (0, 0, 1)
    else:
        cp.pixels[0] = (0, 0, 0)

    if temp_f > 78:
        cp.pixels[1] = (0, 0, 1)
    else:
        cp.pixels[1] = (0, 0, 0)

    if temp_f > 79:
        cp.pixels[2] = (0, 0, 1)
    else:
        cp.pixels[2] = (0, 0, 0)

    if temp_f > 80:
        cp.pixels[3] = (1, 1, 0)
    else:
        cp.pixels[3] = (0, 0, 0)

    if temp_f > 81:
        cp.pixels[4] = (1, 1, 0)
    else:
        cp.pixels[4] = (0, 0, 0)

    if temp_f > 82:
        cp.pixels[5] = (1, 1, 0)
    else:
        cp.pixels[5] = (0, 0, 0)

    if temp_f > 83:
        cp.pixels[6] = (1, 1, 0)
    else:
        cp.pixels[6] = (0, 0, 0)

    if temp_f > 84:
        cp.pixels[7] = (1, 0, 0)
    else:
        cp.pixels[7] = (0, 0, 0)

    if temp_f > 85:
        cp.pixels[8] = (1, 0, 0)
    else:
        cp.pixels[8] = (0, 0, 0)

    if temp_f > 86:
        cp.pixels[9] = (1, 0, 0)
    else:
        cp.pixels[9] = (0, 0, 0)
