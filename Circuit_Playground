#Flip Flop
from adafruit_circuitplayground import cp

while True:
    if cp.switch == True:
        for i in range(0, 5):
            cp.pixels[i] = (0, 5, 0)
        for i in range(5, 10):
            cp.pixels[i] = (0, 0, 0)
    else:
        for i in range(0, 5):
            cp.pixels[i] = (0, 0, 0)
        for i in range(5, 10):
            cp.pixels[i] = (0, 5, 0)

#Tippy
from adafruit_circuitplayground import cp

while True:
    x, y, z = cp.acceleration
    if x > 2:
        for i in range(1, 4):
            cp.pixels[i] = (0, 5, 0)
        for i in range(6, 9):
            cp.pixels[i] = (0, 0, 0)
    elif x < -2:
        for i in range(1, 4):
            cp.pixels[i] = (0, 0, 0)
        for i in range(6, 9):
            cp.pixels[i] = (5, 0, 0)

#Thermometer
from adafruit_circuitplayground import cp

while True:
    temp_f = cp.temperature * 1.8 + 32

    for i in range(10):
        if i == 0 and temp_f < 78:
            cp.pixels[i] = (0, 0, 1)
        elif i == 0 and temp_f >= 78:
            cp.pixels[i] = (0, 0, 1)
        elif i == 1 and temp_f > 78:
            cp.pixels[i] = (0, 0, 1)
        elif i == 2 and temp_f > 79:
            cp.pixels[i] = (0, 0, 1)
        elif i == 3 and temp_f > 80:
            cp.pixels[i] = (1, 1, 0)
        elif i == 4 and temp_f > 81:
            cp.pixels[i] = (1, 1, 0)
        elif i == 5 and temp_f > 82:
            cp.pixels[i] = (1, 1, 0)
        elif i == 6 and temp_f > 83:
            cp.pixels[i] = (1, 1, 0)
        elif i == 7 and temp_f > 84:
            cp.pixels[i] = (1, 0, 0)
        elif i == 8 and temp_f > 85:
            cp.pixels[i] = (1, 0, 0)
        elif i == 9 and temp_f > 86:
            cp.pixels[i] = (1, 0, 0)
        else:
            cp.pixels[i] = (0, 0, 0)

